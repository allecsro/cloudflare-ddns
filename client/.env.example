# Cloudflare Worker Configuration (Required)
WORKER_URL=https://your-worker.your-subdomain.workers.dev/dyndns/update
PRESHARED_SECRET=your-secret-code-minimum-16-characters

# Hostnames to update (Required, comma-separated)
HOSTNAMES=home.example.com,server.example.com

# IP check interval in seconds (Optional, default: 300)
CHECK_INTERVAL=300

# IP version: 4, 6, or both (Optional, default: 4)
IP_VERSION=4

# IP providers: all, or comma-separated list (Optional, default: all)
# Available: ipify, cloudflare, icanhazip, ifconfig, ipinfo, seeip
IP_PROVIDERS=all

# Log level: debug, info, warn, error (Optional, default: info)
LOG_LEVEL=info

# Web UI port (Optional, default: 8080)
SERVER_PORT=8080

# GHCR username for docker-compose (Optional)
GITHUB_USERNAME=allecsro
